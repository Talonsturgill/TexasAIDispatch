[
  {
    "id": "c1",
    "start": 0.56,
    "end": 4.74,
    "text": "What did Denton\u2019s first hearing do to new local data-center applications?",
    "source": "measured_boundary"
  },
  {
    "id": "c2",
    "start": 5.28,
    "end": 9.56,
    "text": "At the first hearing, all twenty speakers supported the proposed moratorium.",
    "source": "measured_boundary"
  },
  {
    "id": "c3",
    "start": 10.1,
    "end": 14.96,
    "text": "The proposal would halt acceptance, processing, and approval of new data-center applications.",
    "source": "measured_boundary"
  },
  {
    "id": "c4",
    "start": 15.46,
    "end": 17.0,
    "text": "But council took no vote.",
    "source": "measured_boundary"
  },
  {
    "id": "c5",
    "start": 17.52,
    "end": 19.28,
    "text": "The proposed local gate stayed open.",
    "source": "measured_boundary"
  },
  {
    "id": "c6",
    "start": 20.24,
    "end": 21.8,
    "text": "The state acted separately.",
    "source": "measured_boundary"
  },
  {
    "id": "c7",
    "start": 22.32,
    "end": 26.58,
    "text": "Abbott directed TCEQ to halt data-center permits pending an ERCOT audit.",
    "source": "measured_boundary"
  },
  {
    "id": "c8",
    "start": 27.4,
    "end": 30.92,
    "text": "Denton\u2019s electric transmission was near capacity, city staff warned.",
    "source": "measured_boundary"
  },
  {
    "id": "c9",
    "start": 31.7,
    "end": 34.66,
    "text": "Denton has scheduled a second hearing for October 27th.",
    "source": "measured_boundary"
  },
  {
    "id": "c10",
    "start": 35.42,
    "end": 37.12,
    "text": "Denton took no local vote.",
    "source": "measured_boundary"
  },
  {
    "id": "c11",
    "start": 37.58,
    "end": 40.34,
    "text": "The state separately directed a permit halt pending the audit.",
    "source": "measured_boundary"
  }
]
