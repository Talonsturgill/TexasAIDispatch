      "start": 0.82,
      "end": 2.96,
      "text": "Near Barry, in Navarro County,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c2",
      "start": 3.08,
      "end": 4.92,
      "text": "robots now do the heavy lifting",
      "source": "recognizer_word_times"
    },
    {
      "id": "c3",
      "start": 4.96,
      "end": 6.52,
      "text": "on part of a solar farm.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c4",
      "start": 6.56,
      "end": 9.48,
      "text": "A person still has to set each piece down.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c5",
      "start": 9.94,
      "end": 14.37,
      "text": "The project is Tormes Solar, 457 megawatts,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c6",
      "start": 14.46,
      "end": 15.965,
      "text": "built by the contractor",
