    },
    {
      "id": "c11",
      "start": 24.76,
      "end": 27.3,
      "text": "crews set steel tubes in the field first.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c12",
      "start": 27.56,
      "end": 29.25,
      "text": "Then workers lift heavy",
