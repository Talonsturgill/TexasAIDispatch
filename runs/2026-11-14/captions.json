    },
    {
      "id": "c26",
      "start": 52.69,
      "end": 54.49,
      "text": "one panel and one tracker,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c27",
      "start": 54.53,
      "end": 56.92,
      "text": "made by First Solar and Nextpower.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c28",
      "start": 57.52,
      "end": 60.82,
      "text": "Then AI-assisted tools check every unit,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c29",
      "start": 60.86,
      "end": 61.88,
      "text": "so a panel in the",
