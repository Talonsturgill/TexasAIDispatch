    },
    {
      "id": "c17",
      "start": 36.92,
      "end": 38.61,
      "text": "California, flipped the order.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c18",
      "start": 38.65,
      "end": 41.46,
      "text": "It parks a factory line right in the field.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c19",
      "start": 41.7,
      "end": 42.93,
      "text": "On that line,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c20",
      "start": 42.97,
      "end": 44.62,
      "text": "robots fasten the panels",
