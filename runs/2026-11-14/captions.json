    },
    {
      "id": "c33",
      "start": 68.08,
      "end": 69.27,
      "text": "Running around the clock,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c34",
      "start": 69.31,
      "end": 71.6,
      "text": "that is more than 20 megawatts a week.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c35",
      "start": 72.26,
      "end": 75.44,
      "text": "Next, a robot loads the table onto a rover,",
      "source": "recognizer_word_times"
