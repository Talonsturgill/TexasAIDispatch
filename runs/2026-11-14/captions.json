      "source": "recognizer_word_times"
    },
    {
      "id": "c23",
      "start": 47.91,
      "end": 50.3,
      "text": "The finished piece is a solar table.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c24",
      "start": 50.36,
      "end": 51.08,
      "text": "For now,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c25",
      "start": 51.12,
      "end": 52.65,
      "text": "the line is optimized for",
