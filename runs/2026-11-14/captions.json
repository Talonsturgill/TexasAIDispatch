      "start": 16.005,
      "end": 18.52,
      "text": "SOLV Energy for Matrix Renewables.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c8",
      "start": 18.92,
      "end": 20.17,
      "text": "Building it is expected",
      "source": "recognizer_word_times"
    },
    {
      "id": "c9",
      "start": 20.21,
      "end": 22.82,
      "text": "to support about 450 jobs.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c10",
      "start": 23.16,
      "end": 24.72,
      "text": "On most solar farms,",
