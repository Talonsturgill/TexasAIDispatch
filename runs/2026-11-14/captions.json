    {
      "id": "c36",
      "start": 75.48,
      "end": 78.22,
      "text": "and the rover drives it out into the field.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c37",
      "start": 78.48,
      "end": 80.38,
      "text": "Tormes is the first site where",
      "source": "recognizer_word_times"
    },
    {
      "id": "c38",
      "start": 80.42,
      "end": 82.93,
      "text": "this version runs with autonomous rovers.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c39",
      "start": 83.44,
      "end": 84.96,
      "text": "Here is the fair doubt.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c40",
      "start": 85.0,
      "end": 86.67,
      "text": "This is a proof of concept",
      "source": "recognizer_word_times"
    },
    {
      "id": "c41",
      "start": 86.71,
      "end": 88.46,
      "text": "on a portion of the project.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c42",
      "start": 88.5,
      "end": 90.86,
      "text": "Those speed figures are the company's own,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c43",
      "start": 90.9,
      "end": 93.62,
      "text": "and it says real output depends on the site.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c44",
      "start": 93.8,
      "end": 96.2,
      "text": "The robots also stop short.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c45",
      "start": 96.38,
