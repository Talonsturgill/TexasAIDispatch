    },
    {
      "id": "c30",
      "start": 61.92,
      "end": 64.02,
      "text": "wrong spot gets caught right away.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c31",
      "start": 64.57,
      "end": 66.45,
      "text": "Terabase says one line runs",
