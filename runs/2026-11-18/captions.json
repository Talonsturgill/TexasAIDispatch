{
  "method": "recognizer_word_times",
  "cues": [
    {
      "id": "c1",
      "start": 0.8,
      "end": 2.52,
      "text": "Picture a crew on Mars,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c2",
      "start": 2.64,
      "end": 5.18,
      "text": "and one of them has severe back pain.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c3",
      "start": 5.28,
      "end": 7.19,
      "text": "A call home for help can take up",
      "source": "recognizer_word_times"
    },
    {
      "id": "c4",
      "start": 7.23,
      "end": 9.54,
      "text": "to 44 minutes to make the round trip.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c5",
      "start": 9.94,
      "end": 12.34,
      "text": "So who fetches the medical bag?",
      "source": "recognizer_word_times"
    },
    {
      "id": "c6",
      "start": 12.98,
      "end": 13.94,
      "text": "Look again.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c7",
      "start": 14.26,
      "end": 15.385,
      "text": "This is a lab at",
      "source": "recognizer_word_times"
    },
    {
      "id": "c8",
      "start": 15.425,
      "end": 17.65,
      "text": "NASA's Johnson Space Center in Houston,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c9",
      "start": 17.69,
      "end": 19.31,
      "text": "built with habitat mockups,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c10",
      "start": 19.46,
      "end": 22.54,
      "text": "and the one reaching for the bag is a robot.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c11",
      "start": 23.44,
      "end": 24.88,
      "text": "Google Public Sector built it",
      "source": "recognizer_word_times"
    },
    {
      "id": "c12",
      "start": 24.92,
      "end": 26.58,
      "text": "with the robotics team at Johnson,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c13",
      "start": 26.7,
      "end": 28.32,
      "text": "NASA's Human Research Program",
      "source": "recognizer_word_times"
    },
    {
      "id": "c14",
      "start": 28.36,
      "end": 29.92,
      "text": "and the Jet Propulsion Laboratory.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c15",
      "start": 30.52,
      "end": 32.68,
      "text": "Its first job sounds simple.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c16",
      "start": 33.16,
      "end": 36.06,
      "text": "Find the medical bag and move it.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c17",
      "start": 36.76,
      "end": 38.51,
      "text": "Before it touched real hardware,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c18",
      "start": 38.55,
      "end": 40.73,
      "text": "it practised the moves in a physics simulator,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c19",
      "start": 40.77,
      "end": 43.08,
      "text": "where a dropped bag costs nothing.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c20",
      "start": 43.76,
      "end": 46.71,
      "text": "Its brain is an open model called Pi zero,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c21",
      "start": 46.82,
      "end": 48.98,
      "text": "from a company called Physical Intelligence.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c22",
      "start": 49.32,
      "end": 52.46,
      "text": "Google fine tuned it in just 2.5 hours.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c23",
      "start": 53.42,
      "end": 56.44,
      "text": "Mars missions need light, low power hardware.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c24",
      "start": 56.54,
      "end": 57.98,
      "text": "So over two years,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c25",
      "start": 58.02,
      "end": 59.72,
      "text": "the team tested about 15",
      "source": "recognizer_word_times"
    },
    {
      "id": "c26",
      "start": 59.76,
      "end": 61.42,
      "text": "compact devices to run it on.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c27",
      "start": 62.1,
      "end": 63.94,
      "text": "To know where its own hand is,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c28",
      "start": 63.98,
      "end": 65.76,
      "text": "the robot uses a camera that",
      "source": "recognizer_word_times"
    },
    {
      "id": "c29",
      "start": 65.8,
      "end": 67.8,
      "text": "stands across the room and watches it.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c30",
      "start": 68.36,
      "end": 70.41,
      "text": "The Jet Propulsion Laboratory is adapting",
      "source": "recognizer_word_times"
    },
    {
      "id": "c31",
      "start": 70.45,
      "end": 72.59,
      "text": "tools built to track satellites in orbit,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c32",
      "start": 72.63,
      "end": 73.58,
      "text": "so the robot can",
      "source": "recognizer_word_times"
    },
    {
      "id": "c33",
      "start": 73.62,
      "end": 75.0,
      "text": "understand the room around it.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c34",
      "start": 75.56,
      "end": 78.31,
      "text": "In early lab tests at the iMETRO facility,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c35",
      "start": 78.35,
      "end": 79.7,
      "text": "it found and moved the",
      "source": "recognizer_word_times"
    },
    {
      "id": "c36",
      "start": 79.74,
      "end": 81.7,
      "text": "bag 85 percent of the time.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c37",
      "start": 82.26,
      "end": 83.86,
      "text": "That means some tries missed.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c38",
      "start": 84.36,
      "end": 87.7,
      "text": "It is one task, in one lab, on Earth.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c39",
      "start": 88.58,
      "end": 89.76,
      "text": "Google has not confirmed",
      "source": "recognizer_word_times"
    },
    {
      "id": "c40",
      "start": 89.8,
      "end": 91.44,
      "text": "a space ready robot exists.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c41",
      "start": 92.18,
      "end": 93.88,
      "text": "The goal is bigger.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c42",
      "start": 94.22,
      "end": 95.2,
      "text": "The robot could fetch",
      "source": "recognizer_word_times"
    },
    {
      "id": "c43",
      "start": 95.24,
      "end": 96.4,
      "text": "and prepare an ultrasound,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c44",
      "start": 96.44,
      "end": 97.96,
      "text": "and take simple voice orders,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c45",
      "start": 98.0,
      "end": 99.56,
      "text": "with astronauts in command.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c46",
      "start": 100.46,
      "end": 102.86,
      "text": "Even then, it never makes the call.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c47",
      "start": 103.38,
      "end": 104.66,
      "text": "The crew medical officer",
      "source": "recognizer_word_times"
    },
    {
      "id": "c48",
      "start": 104.7,
      "end": 106.62,
      "text": "opens the bag and decides.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c49",
      "start": 107.86,
      "end": 108.92,
      "text": "Back on Mars,",
      "source": "recognizer_word_times"
    },
    {
      "id": "c50",
      "start": 108.98,
      "end": 111.56,
      "text": "the answer from Earth is still on its way.",
      "source": "recognizer_word_times"
    },
    {
      "id": "c51",
      "start": 112.08,
      "end": 113.92,
      "text": "The bag is already here.",
      "source": "recognizer_word_times"
    }
  ]
}
