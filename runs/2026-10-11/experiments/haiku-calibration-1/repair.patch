   const THIRD_LINE_MIN = 40;
+  // SubtitleTrack lifts each cue's band by up to this many pixels and settles it to the seat over
+  // its first six frames, so the band can sit this far above the resting place the gate checks.
+  // caption_gate_repair_test.mjs pins the renderer's settle range to this value.
+  const ENTRANCE_LIFT = 6;
   const tallest = captionBandHeight({lines: ['', '', ''], size: 44});
   const verdict = (cue, fit) => {
     const declared = cue.max_lines === undefined ? 2 : cue.max_lines;
@@ -34,10 +38,19 @@ try {
     } else if (fit.size < 29) {
       return `caption ${cue.id} would exceed the lower two-line band`;
