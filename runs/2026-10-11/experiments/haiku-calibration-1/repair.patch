diff --git a/video-engine/tests/caption_gate_repair_test.mjs b/video-engine/tests/caption_gate_repair_test.mjs
new file mode 100644
index 0000000..1be1dbc
--- /dev/null
+++ b/video-engine/tests/caption_gate_repair_test.mjs
@@ -0,0 +1,162 @@
+#!/usr/bin/env node
+// Regression test for two caption gate defects, run through the gate's own command line.
+//
+// 1. Settle offset. SubtitleTrack (DispatchOverlays.tsx) lifts a cue's band by 6 px at its first
+//    frame and settles it to the seat over six frames. A three-line size 44 band therefore sits
+//    6 px above the seat the gate enforces unless the gate bounds the lift too. The three-line
+//    size 44 cue must be refused, and the three-line size 42 cue, which fits with the lift, must pass.
+// 2. Template. alloy-loop-v1 (AlloyLoopEpisode.tsx) ignores max_lines, so a declared three-line
+//    cue on that template is refused before render.
+//
+// Controls prove that undeclared and declared two-line cues keep the exact verdict and layout
+// the gate printed before the repair. Those expected strings were recorded from the pre-repair gate.
+//
+// Prints RESULT and MUTATION lines. Exits non-zero on any FAIL or MISSED.
+import {build} from 'esbuild';
+import {execFile} from 'node:child_process';
+import {mkdtemp, readFile, rm, writeFile} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {createRequire} from 'node:module';
+import {fileURLToPath} from 'node:url';
+import path from 'node:path';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const root = path.dirname(here);
+const gatePath = path.join(here, 'caption_board_fit.mjs');
+const temp = await mkdtemp(path.join(tmpdir(), 'caption-gate-repair-'));
+
+const TEXT_THREE_44 = 'utility says no major fire has needed a response since launch and regulators will';
+const TEXT_THREE_42 = 'major fire has needed a response since launch and regulators will review every filing';
+const TEXT_SHORT = 'The proposed local gate stayed open.';
+const TEXT_LONG = "The utility's wildfire lead says no major fire has needed an AEP Texas response since launch.";
+
+// Output recorded from the pre-repair gate with `--report`, trailing newline removed.
+const GOLDEN_DEFAULT_TWO_LINE = [
+  'caption_board_fit: 1 exact board cues fit the lower band in two lines',
+  "  c1 size 29 lines 2 band top 1329.7: The utility's wildfire lead says no major fire | has needed an AEP Texas response since launch.",
+].join('\n');
+const GOLDEN_SHORT_TWO_LINE = [
+  'caption_board_fit: 1 exact board cues fit the lower band in two lines',
+  '  c1 size 44 lines 2 band top 1292.8: The proposed local | gate stayed open.',
+].join('\n');
+
+let boardCount = 0;
+const gate = (board) => new Promise((resolve) => {
+  const file = path.join(temp, `board-${++boardCount}.json`);
+  const args = [gatePath, '--board', file, '--report'];
+  writeFile(file, JSON.stringify(board)).then(() => {
+    execFile(process.execPath, args, {cwd: root}, (err, stdout, stderr) => {
+      resolve({code: err ? (typeof err.code === 'number' ? err.code : 1) : 0,
+        stdout: stdout.trimEnd(), stderr});
+    });
+  });
+});
+
+const cue = (text, extra = {}) => ({id: 'c1', text, start: 0, end: 4, ...extra});
+const board = (captions, extra = {}) => ({date: '2026-10-14', captions, ...extra});
+
+// The renderer's real layout, bundled from the same probe the gate uses.
+const probeFile = path.join(temp, 'probe.cjs');
+await build({entryPoints: [path.join(here, 'type_fit_probe.tsx')], bundle: true, platform: 'node',
+  format: 'cjs', jsx: 'automatic', outfile: probeFile, logLevel: 'error'});
+const {captionLayout, captionBandHeight, CAPTION_TEXT_WIDTH, SAFE_BOTTOM} =
+  createRequire(import.meta.url)(probeFile);
+const fit44 = captionLayout(TEXT_THREE_44, CAPTION_TEXT_WIDTH, 3);
+const fit42 = captionLayout(TEXT_THREE_42, CAPTION_TEXT_WIDTH, 3);
+const tallest = captionBandHeight({lines: ['', '', ''], size: 44});
+
+const results = {};
+const mutations = {};
+const fail = (name, detail) => { results[name] = {pass: false, detail}; };
+const pass = (name) => { results[name] = {pass: true, detail: ''}; };
+
+// repaired_settle_offset
+{
+  const name = 'repaired_settle_offset';
+  try {
+    if (fit44.lines.length !== 3 || fit44.size !== 44 || fit42.lines.length !== 3 || fit42.size !== 42)
+      throw new Error(`precondition: layouts moved (44: ${fit44.size}/${fit44.lines.length}, 42: ${fit42.size}/${fit42.lines.length})`);
+    const refused44 = await gate(board([cue(TEXT_THREE_44, {max_lines: 3})]));
+    if (refused44.code === 0) throw new Error('three lines at 44 was approved');
+    if (!refused44.stderr.includes('rises above the three-line caption seat'))
+      throw new Error(`three lines at 44 refused for another reason: ${refused44.stderr.trim().split('\n').find((l) => l.includes('Error')) ?? refused44.stderr}`);
+    const approved42 = await gate(board([cue(TEXT_THREE_42, {max_lines: 3})]));
+    if (approved42.code !== 0 || !approved42.stdout.includes('declared three-line cue at 42'))
+      throw new Error(`three lines at 42 with the lift accounted for was not approved: ${approved42.stderr.trim()}`);
+    // The gate's lift must equal the renderer's settle range, or the bound no longer describes the draw.
+    const gateSource = await readFile(gatePath, 'utf8');
+    const renderSource = await readFile(path.join(root, 'src/lib/DispatchOverlays.tsx'), 'utf8');
+    const gateLift = gateSource.match(/const ENTRANCE_LIFT = (\d+);/)?.[1];
+    const renderLift = renderSource.match(/interpolate\(\(t - cue\.start\) \* fps, \[0, 6\], \[-(\d+), 0\]/)?.[1];
+    if (!gateLift || gateLift !== renderLift) throw new Error(`gate lift ${gateLift} does not match renderer settle ${renderLift}`);
+    pass(name);
+  } catch (e) { fail(name, e.message); }
+}
+
+// repaired_alloy_max_lines
+{
+  const name = 'repaired_alloy_max_lines';
+  try {
+    const declared = await gate(board([cue(TEXT_SHORT, {max_lines: 3})], {cinematic_template: 'alloy-loop-v1'}));
+    if (declared.code === 0) throw new Error('a declared three-line cue on alloy-loop-v1 was approved');
+    if (!declared.stderr.includes('ignores max_lines')) throw new Error('refused for another reason');
+    const undeclared = await gate(board([cue(TEXT_SHORT)], {cinematic_template: 'alloy-loop-v1'}));
+    if (undeclared.code !== 0 || undeclared.stdout !== GOLDEN_SHORT_TWO_LINE)
+      throw new Error('an undeclared cue on alloy-loop-v1 changed its verdict');
+    pass(name);
+  } catch (e) { fail(name, e.message); }
+}
+
+// control_default_two_line
+{
+  const name = 'control_default_two_line';
+  try {
+    const run = await gate(board([cue(TEXT_LONG)]));
+    if (run.code !== 0) throw new Error(`exit ${run.code}: ${run.stderr.trim()}`);
+    if (run.stdout !== GOLDEN_DEFAULT_TWO_LINE) throw new Error(`output changed:\n${run.stdout}`);
+    pass(name);
+  } catch (e) { fail(name, e.message); }
+}
+
+// control_declared_fits_two_lines
+{
+  const name = 'control_declared_fits_two_lines';
+  try {
+    const declared = await gate(board([cue(TEXT_SHORT, {max_lines: 3})]));
+    const undeclared = await gate(board([cue(TEXT_SHORT)]));
+    if (declared.code !== 0 || undeclared.code !== 0) throw new Error('a cue that fits two lines was refused');
+    if (declared.stdout !== GOLDEN_SHORT_TWO_LINE || undeclared.stdout !== GOLDEN_SHORT_TWO_LINE)
+      throw new Error(`output changed:\n${declared.stdout}`);
+    pass(name);
+  } catch (e) { fail(name, e.message); }
+}
+
+// Mutations. Each re-applies the defective logic to the repaired case and checks that the repaired
+// expectation then fails, so reverting the fix is caught by this file, not by luck.
+{
+  // Old settle logic: the band top is SAFE_BOTTOM - h, with no entrance lift.
+  const oldApproves = SAFE_BOTTOM - captionBandHeight(fit44) >= SAFE_BOTTOM - tallest - 1e-6;
+  const repairedHolds = !oldApproves; // the repaired expectation is that 44 is NOT approved
+  mutations.settle_offset_repair = repairedHolds ? 'MISSED' : 'CAUGHT';
+}
+{
+  // Old template logic: the gate never read cinematic_template, so the same board is approved.
+  const oldGate = await gate(board([cue(TEXT_SHORT, {max_lines: 3})]));
+  const repairedHolds = oldGate.code !== 0; // the repaired expectation is that the board is refused
+  mutations.alloy_template_repair = repairedHolds ? 'MISSED' : 'CAUGHT';
+}
+
+await rm(temp, {recursive: true, force: true});
+
+const order = ['repaired_settle_offset', 'repaired_alloy_max_lines', 'control_default_two_line', 'control_declared_fits_two_lines'];
+let ok = true;
+for (const name of order) {
+  const r = results[name];
+  console.log(`RESULT ${name} ${r.pass ? 'PASS' : 'FAIL'}`);
+  if (!r.pass) { ok = false; console.error(`${name}: ${r.detail}`); }
+}
+for (const [name, status] of Object.entries(mutations)) {
+  console.log(`MUTATION ${name} ${status}`);
+  if (status !== 'CAUGHT') ok = false;
+}
+process.exitCode = ok ? 0 : 1;
-- 
