    {
      "id": "c1",
      "start": 1.06,
      "end": 5.42,
      "text": "The blower fan in many modern air conditioners uses a permanent-magnet motor.",
      "source": "measured_boundary"
    },
    {
      "id": "c2",
      "start": 5.94,
      "end": 10.32,
      "text": "The University of Houston wants AI to find new magnet materials.",
      "source": "measured_boundary"
    },
    {
      "id": "c3",
      "start": 10.82,
      "end": 14.74,
      "text": "On September 1st, the university announced federal support for that search.",
      "source": "measured_boundary"
    },
    {
      "id": "c4",
      "start": 15.3,
      "end": 20.4,
      "text": "The plan pairs AI predictions of new compounds with AI predictions of how to make them.",
      "source": "measured_boundary"
    },
    {
      "id": "c5",
      "start": 21.08,
      "end": 25.32,
      "text": "Houston researchers will synthesize the candidates and measure their magnetic properties.",
      "source": "measured_boundary"
    },
    {
      "id": "c6",
      "start": 25.92,
      "end": 30.14,
      "text": "The goal is materials that can be sourced and made more reliably at home.",
      "source": "measured_boundary"
    },
    {
      "id": "c7",
      "start": 30.86,
      "end": 34.02,
      "text": "The plan runs from prediction to synthesis to testing.",
      "source": "measured_boundary"
    },
    {
      "id": "c8",
      "start": 34.54,
      "end": 37.0,
      "text": "Commercialization remains the ultimate milestone.",
      "source": "measured_boundary"
    },
    {
      "id": "c9",
      "start": 37.86,
      "end": 41.18,
      "text": "A candidate has to leave the screen before it can turn the fan.",
      "source": "measured_boundary"
