    {
      "id": "c1",
      "start": 0.58,
      "end": 7.06,
      "text": "UT San Antonio says some people could have ankle-deep water in their yard before a flood warning sounds on their phone.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c2",
      "start": 7.7,
      "end": 13.06,
      "text": "So its researchers built a flood station that charges itself from light and needs no cell tower.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c3",
      "start": 13.8,
      "end": 16.8,
      "text": "Four optical sensors at different heights watch the water,",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c4",
      "start": 16.92,
      "end": 19.74,
      "text": "along with rain, temperature, humidity and light.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c5",
      "start": 20.34,
      "end": 23.44,
      "text": "A small chip on the station runs the AI itself,",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c6",
      "start": 23.62,
      "end": 26.06,
      "text": "so it judges flood risk without a central server.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c7",
      "start": 26.74,
      "end": 31.7,
      "text": "When the risk rises, a radio signal can carry more than a half-mile through city streets,",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c8",
      "start": 31.92,
      "end": 34.5,
      "text": "and up to five miles in open country, to a hub.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c9",
      "start": 35.16,
      "end": 41.4,
      "text": "At the hub, a second, larger AI model draws a map of how flooding could spread, for emergency responders.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c10",
      "start": 42.12,
      "end": 48.24,
      "text": "The university reports ninety eight point eight two percent validation accuracy from early assessments after training,",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c11",
      "start": 48.6,
      "end": 49.76,
      "text": "and no field result.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c12",
      "start": 50.44,
      "end": 52.7,
      "text": "It names no town that has installed one.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c13",
      "start": 53.34,
      "end": 54.66,
      "text": "Deployment is still the goal.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    }
