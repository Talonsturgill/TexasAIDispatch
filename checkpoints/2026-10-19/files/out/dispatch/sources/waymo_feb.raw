.com/" data-tracking="{}" class="_link_b7krl_11 variant:plain color:black">Waymo Shop</a></li><li class="_linksItem_zgq1c_108"><button type="button" data-open-consent-settings="true" class="_linksItemButton_zgq1c_123">Cookie Settings</button></li></ul></nav><section class="_signUp_zgq1c_166"><div class="_markdown_1o1pf_1 md"><p>Sign up for updates to get the latest on Waymo.</p>
</div><a href="/updates/" data-tracking="{&quot;event&quot;:&quot;newsletter_cta&quot;,&quot;click_text&quot;:&quot;Sign up&quot;,&quot;section_title&quot;:&quot;footer&quot;}" class="_link_b7krl_11 variant:primary color:blue">Sign up</a></section><hr class="_divider_zgq1c_194"/><ul class="_socials_zgq1c_52"><li><a href="https://twitter.com/waymo/" data-tracking="{}" title="Waymo on X" class="_link_b7krl_11 variant:plain color:black"><svg aria-hidden="false" aria-label="Waymo on X" class="_logo-twitter_zgq1c_238"><use href="/assets/BDOs7_Uj.svg#logo-twitter"></use></svg></a></li><li><a href="https://www.linkedin.com/company/waymo" data-tracking="{}" title="Waymo on LinkedIn" class="_link_b7krl_11 variant:plain color:black"><svg aria-hidden="false" aria-label="Waymo on LinkedIn" class="_logo-linkedin_zgq1c_242"><use href="/assets/BDOs7_Uj.svg#logo-linkedin"></use></svg></a></li><li><a href="https://www.instagram.com/waymo/?hl=en" data-tracking="{}" title="Waymo on Instagram" class="_link_b7krl_11 variant:plain color:black"><svg aria-hidden="false" aria-label="Waymo on Instagram" class="_logo-instagram_zgq1c_246"><use href="/assets/BDOs7_Uj.svg#logo-instagram"></use></svg></a></li><li><a href="https://facebook.com/waymo/" data-tracking="{}" title="Waymo on Facebook" class="_link_b7krl_11 variant:plain color:black"><svg aria-hidden="false" aria-label="Waymo on Facebook" class="_logo-facebook_zgq1c_250"><use href="/assets/BDOs7_Uj.svg#logo-facebook"></use></svg></a></li><li><a href="https://www.youtube.com/waymo" data-tracking="{}" title="Waymo on YouTube" class="_link_b7krl_11 variant:plain color:black"><svg aria-hidden="false" aria-label="Waymo on YouTube" class="_logo-youtube_zgq1c_254"><use href="/assets/BDOs7_Uj.svg#logo-youtube"></use></svg></a></li><li><a href="https://www.tiktok.com/@waymo" data-tracking="{}" title="Waymo on Tiktok" class="_link_b7krl_11 variant:plain color:black"><svg aria-hidden="false" aria-label="Waymo on Tiktok" class="_logo-tiktok_zgq1c_258"><use href="/assets/BDOs7_Uj.svg#logo-tiktok"></use></svg></a></li></ul><p class="_copyright_zgq1c_279">© 2019-2026 Waymo LLC</p></div></footer></div><root-consent><style nonce="D22aiG5DgJoFmHvicO/s5Q==">/* Styles for the <root-consent> banner + preference center. Scoped under the
 * custom element tag so they can't leak into the host page. Injected inline
 * (CSP nonce) by the SSR template, kept small for the critical path.
 *
 * The custom properties below are the theming surface: a site can restyle the
 * banner by setting them on `root-consent` (or any ancestor) from its own CSS.
 */
root-consent {
  --rc-bg: #ffffff;
  --rc-fg: #202124;
  --rc-muted: #5f6368;
  --rc-border: #dadce0;
  --rc-accent: #1a73e8;
  --rc-accent-hover: #1765cc;
  --rc-accent-fg: #ffffff;
  --rc-radius: 12px;
}

root-consent [hidden] {
  display: none !important;
}

root-consent .rc-banner {
  position: fixed;
  z-index: 2147483000;
  left: 16px;
  right: 16px;
  bottom: 16px;
  max-width: 560px;
  margin-inline: auto;
  background: var(--rc-bg);
  color: var(--rc-fg);
  border: 1px solid var(--rc-border);
  border-radius: var(--rc-radius);
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
  padding: 20px;
  font-family: inherit;
  font-size: 14px;
  line-height: 1.5;
}

root-consent .rc-title {
  margin: 0 0 8px;
  font-size: 16px;
  font-weight: 600;
}

root-consent .rc-body {
  margin: 0 0 16px;
  color: var(--rc-muted);
}

root-consent .rc-body p {
  margin: 0 0 8px;
}

root-consent .rc-body p:last-child {
  margin-bottom: 0;
}

root-consent .rc-body a {
  color: var(--rc-accent);
}

root-consent .rc-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

root-consent .rc-btn {
  appearance: none;
  cursor: pointer;
  border-radius: 999px;
  border: 1px solid var(--rc-border);
  background: var(--rc-bg);
  color: var(--rc-fg);
  padding: 9px 18px;
  font: inherit;
  font-weight: 500;
}

root-consent .rc-btn:hover {
  background: #f1f3f4;
}

root-consent .rc-btn--primary {
  background: var(--rc-accent);
  border-color: var(--rc-accent);
  color: var(--rc-accent-fg);
}

root-consent .rc-btn--primary:hover {
  background: var(--rc-accent-hover);
}

/* Less-prominent "Manage Preferences" / "Save Preferences" action: styled as a
 * text link so the primary Accept All / Reject All buttons stay dominant and
 * visually equivalent to each other. */
root-consent .rc-btn--link {
  background: transparent;
  border-color: transparent;
  color: var(--rc-accent);
  padding-inline: 8px;
  text-decoration: underline;
}

root-consent .rc-btn--link:hover {
  background: transparent;
  text-decoration: none;
}

root-consent .rc-btn:focus-visible {
  outline: 2px solid var(--rc-accent);
  outline-offset: 2px;
}

/* Preference center (modal) */
root-consent .rc-prefs {
  position: fixed;
  z-index: 2147483001;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  background: rgba(32, 33, 36, 0.5);
}

root-consent .rc-prefs-dialog {
  background: var(--rc-bg);
  color: var(--rc-fg);
  border-radius: var(--rc-radius);
  max-width: 560px;
  width: 100%;
  max-height: 85vh;
  overflow: auto;
  padding: 24px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
}

root-consent .rc-prefs-title {
  margin: 0 0 16px;
  font-size: 18px;
  font-weight: 600;
}

root-consent .rc-cat {
  display: flex;
  gap: 12px;
  padding: 14px 0;
  border-top: 1px solid var(--rc-border);
}

root-consent .rc-cat-text {
  flex: 1;
}

root-consent .rc-cat-name {
  font-weight: 500;
  margin: 0 0 4px;
}

root-consent .rc-cat-desc {
  color: var(--rc-muted);
  font-size: 13px;
  margin: 0;
}

/* Legal note above the preference-center actions. Sits below the last
 * category, so it takes the same top border the categories use. */
root-consent .rc-prefs-note {
  border-top: 1px solid var(--rc-border);
  padding-top: 14px;
  color: var(--rc-muted);
  font-size: 13px;
}

root-consent .rc-prefs-note p {
  margin: 0 0 8px;
}

root-consent .rc-prefs-note p:last-child {
  margin-bottom: 0;
}

root-consent .rc-prefs-note a {
  color: var(--rc-accent);
}

/* Collapse the note's spacing when the CMS leaves it empty. */
root-consent .rc-prefs-note:empty {
  display: none;
}

root-consent .rc-prefs-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 20px;
}

@media (prefers-reduced-motion: no-preference) {
  root-consent .rc-banner {
    animation: rc-slide-up 0.18s ease-out;
  }
}

@keyframes rc-slide-up {
  from {
    transform: translateY(12px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
</style><div data-consent-banner="true" hidden role="dialog" aria-modal="false" aria-label="We value your privacy" aria-describedby="rc-banner-body" class="rc-banner"><p class="rc-title">We value your privacy</p><div id="rc-banner-body" class="rc-body"><p>Waymo and our third-party partners use cookies and similar technologies to ensure our website functions correctly, to analyze site traffic and performance, and to deliver personalized marketing and content. Essential cookies are automatically active to keep our site running safely and reliably. <b>For non-essential cookies, below you can choose to accept all of them, reject all of them, or customize your preferences.</b> You can change your preferences or withdraw your consent at any time by clicking "Cookie Settings" in the website footer. For more detailed information, please review our <a href="https://waymo.com/privacy/">Privacy Policy</a>.</p></div><div class="rc-actions"><button type="button" data-consent-action="accept" class="rc-btn rc-btn--primary">Accept All</button><button type="button" data-consent-action="reject" class="rc-btn rc-btn--primary">Reject All</button><button type="button" data-consent-action="customize" class="rc-btn rc-btn--link">Manage Preferences</button></div></div><div data-consent-prefs="true" hidden class="rc-prefs"><div role="dialog" aria-modal="true" aria-label="Manage Preferences" class="rc-prefs-dialog"><p class="rc-prefs-title">Manage Preferences</p><div class="rc-cat"><div class="rc-cat-text"><p class="rc-cat-name">Strictly Necessary Cookies</p><p class="rc-cat-desc">These cookies are essential for the website to function properly, enabling core features like network security, load balancing, and remembering your privacy preferences. They cannot be switched off in our systems.</p></div><div><label class="rc-switch"><input type="checkbox" data-category="essential" checked disabled aria-label="Strictly Necessary Cookies"/></label></div></div><div class="rc-cat"><div class="rc-cat-text"><p class="rc-cat-name">Analytics Cookies</p><p class="rc-cat-desc">These cookies allow us and our analytics partners to count visits and traffic sources so we can measure and improve the performance of waymo.com. They help us understand which pages are most and least popular and see how visitors move around the site.</p></div><div><label class="rc-switch"><input type="checkbox" data-category="analytics" aria-label="Analytics Cookies"/></label></div></div><div class="rc-cat"><div class="rc-cat-text"><p class="rc-cat-name">Marketing &amp; Advertising Cookies</p><p class="rc-cat-desc">These cookies may be set through our site by us and our advertising partners. They may be used by us and those companies to build a profile of your interests and show you relevant advertisements on other websites and platforms.</p></div><div><label class="rc-switch"><input type="checkbox" data-category="advertising" aria-label="Marketing &amp; Advertising Cookies"/></label></div></div><div class="rc-cat"><div class="rc-cat-text"><p class="rc-cat-name">Functional &amp; Personalization Cookies</p><p class="rc-cat-desc">These cookies enable the website to provide enhanced functionality and personalization, such as remembering your language preferences or regional settings. If you do not allow these cookies, some or all of these services may not function properly.</p></div><div><label class="rc-switch"><input type="checkbox" data-category="functional" aria-label="Functional &amp; Personalization Cookies"/></label></div></div><div class="rc-prefs-note"><p>If you choose to "Reject All", we will only use strictly necessary cookies.</p></div><div class="rc-prefs-actions"><button type="button" data-consent-action="accept" class="rc-btn rc-btn--primary">Accept All</button><button type="button" data-consent-action="reject" class="rc-btn rc-btn--primary">Reject All</button><button type="button" data-consent-action="save" class="rc-btn rc-btn--link">Save Preferences</button></div></div></div><script type="application/json" data-consent-config="true" nonce="D22aiG5DgJoFmHvicO/s5Q==">{"enabled":true,"flag":"EnableCookieConsent","showCustomizeButton":true,"simulate":false,"policyVersion":"1","cookieName":"waymo-consent","cookieTtlDays":390,"jurisdiction":{"country":"","region":"","mode":"opt-in","tagLoading":"on-consent","defaults":{"essential":true,"analytics":false,"advertising":false,"functional":false},"footerControl":"cookie-settings","initialCookieDelayDuration":0},"recordUrl":"/api/consent.record","copy":{"bannerTitle":"We value your privacy","bannerBody":{"time":1700000000000,"version":"2.28.2","blocks":[{"type":"paragraph","data":{"text":"Waymo and our third-party partners use cookies and similar technologies to ensure our website functions correctly, to analyze site traffic and performance, and to deliver personalized marketing and content. Essential cookies are automatically active to keep our site running safely and reliably. <b>For non-essential cookies, below you can choose to accept all of them, reject all of them, or customize your preferences.</b> You can change your preferences or withdraw your consent at any time by clicking \"Cookie Settings\" in the website footer. For more detailed information, please review our <a href=\"https://waymo.com/privacy/\">Privacy Policy</a>."}}]},"prefsNote":{"version":"2.28.2","time":1700000000000,"blocks":[{"type":"paragraph","data":{"text":"If you choose to \"Reject All\", we will only use strictly necessary cookies."}}]},"acceptAllLabel":"Accept All","rejectAllLabel":"Reject All","customizeLabel":"Manage Preferences","savePreferencesLabel":"Save Preferences","preferencesTitle":"Manage Preferences"},"categories":[{"id":"essential","label":"Strictly Necessary Cookies","description":"These cookies are essential for the website to function properly, enabling core features like network security, load balancing, and remembering your privacy preferences. They cannot be switched off in our systems.","required":t