na_84"><picture class="_picture_1yfl2_2"><source srcset="//lh3.googleusercontent.com/cYBdQq9WvdTshpHTaP4uOjWfZrvkZpbgJadUrvvRfbQMJV4I0Ia0sYumR402AToZKcmp-SU5nQ2-XM7b4tyCMo_Byjwzsvcl7qU=e365-s2880-rw-v1 2x, //lh3.googleusercontent.com/cYBdQq9WvdTshpHTaP4uOjWfZrvkZpbgJadUrvvRfbQMJV4I0Ia0sYumR402AToZKcmp-SU5nQ2-XM7b4tyCMo_Byjwzsvcl7qU=e365-s1440-rw-v1 1x" media="(min-width: 600px)" type="image/webp" width="3840" height="2160"/><source srcset="//lh3.googleusercontent.com/cYBdQq9WvdTshpHTaP4uOjWfZrvkZpbgJadUrvvRfbQMJV4I0Ia0sYumR402AToZKcmp-SU5nQ2-XM7b4tyCMo_Byjwzsvcl7qU=e365-s2880-v1 2x, //lh3.googleusercontent.com/cYBdQq9WvdTshpHTaP4uOjWfZrvkZpbgJadUrvvRfbQMJV4I0Ia0sYumR402AToZKcmp-SU5nQ2-XM7b4tyCMo_Byjwzsvcl7qU=e365-s1440 1x" media="(min-width: 600px)" type="image/jpeg" width="3840" height="2160"/><source srcset="//lh3.googleusercontent.com/cYBdQq9WvdTshpHTaP4uOjWfZrvkZpbgJadUrvvRfbQMJV4I0Ia0sYumR402AToZKcmp-SU5nQ2-XM7b4tyCMo_Byjwzsvcl7qU=e365-s840-rw-v1 2x, //lh3.googleusercontent.com/cYBdQq9WvdTshpHTaP4uOjWfZrvkZpbgJadUrvvRfbQMJV4I0Ia0sYumR402AToZKcmp-SU5nQ2-XM7b4tyCMo_Byjwzsvcl7qU=e365-s420-rw-v1 1x" media="(max-width: 599px)" type="image/webp" width="3840" height="2160"/><img alt="DAL SAT HOU ORL Blog Header" loading="eager" fetchpriority="high" srcset="//lh3.googleusercontent.com/cYBdQq9WvdTshpHTaP4uOjWfZrvkZpbgJadUrvvRfbQMJV4I0Ia0sYumR402AToZKcmp-SU5nQ2-XM7b4tyCMo_Byjwzsvcl7qU=e365-s840-v1 2x, //lh3.googleusercontent.com/cYBdQq9WvdTshpHTaP4uOjWfZrvkZpbgJadUrvvRfbQMJV4I0Ia0sYumR402AToZKcmp-SU5nQ2-XM7b4tyCMo_Byjwzsvcl7qU=e365-s420 1x" src="//lh3.googleusercontent.com/cYBdQq9WvdTshpHTaP4uOjWfZrvkZpbgJadUrvvRfbQMJV4I0Ia0sYumR402AToZKcmp-SU5nQ2-XM7b4tyCMo_Byjwzsvcl7qU=e365-s420" width="3840" height="2160" class="_image_1yfl2_5"/></picture></div></div><h1 id="w-go6rlovg-title" data-speakable="headline" class="_headerTitle_nr1na_118">Ready to Ride: Dallas, Houston, San Antonio, and Orlando</h1></header><aside role="region" aria-label="Article information" class="_sidebar_nr1na_140"><div>February 24, 2026</div><hr class="_divider_nr1na_149"/><ul class="_categories_nr1na_179"><li> Rides</li></ul><p class="_author_nr1na_195">The Waymo Team</p><hr class="_divider_nr1na_149"/><ul class="_socials_nr1na_199"><li class="_shareTwitter_nr1na_214"><w-share data-type="twitter"><button type="button" class="_shareButton_vr19u_3"><span class="_label_vr19u_37">Share on Twitter</span><svg aria-hidden="true"><use href="/assets/BU31Xvf-.svg#community-socials-x"></use></svg></button></w-share></li><li class="_shareLinkedin_nr1na_215"><w-share data-type="linkedin"><button type="button" class="_shareButton_vr19u_3"><span class="_label_vr19u_37">Share on LinkedIn</span><svg aria-hidden="true"><use href="/assets/BU31Xvf-.svg#community-socials-linkedin"></use></svg></button></w-share></li><li class="_shareFacebook_nr1na_216"><w-share data-type="facebook"><button type="button" class="_shareButton_vr19u_3"><span class="_label_vr19u_37">Share on Facebook</span><svg aria-hidden="true"><use href="/assets/BU31Xvf-.svg#community-socials-facebook"></use></svg></button></w-share></li></ul></aside><div data-slot="body" data-speakable="summary" class="_body_nr1na_246"><p>Today, we continue our accelerated growth and welcome the first public riders into our fully autonomous ride-hailing service in four new cities: Dallas, Houston, San Antonio, and Orlando. In addition to marking the first time we’ve opened to the public in multiple cities simultaneously, this brings our total commercial metro areas to 10, and deepens our commitment in the states of Texas and Florida.</p><p>Select riders from the tens of thousands in these cities who have downloaded the Waymo app will receive an invitation to take their first local rides today. We will be inviting new riders on a rolling basis to ensure a seamless experience across our initial service areas, as we meaningfully scale our operations ahead of opening our service to everyone later this year.</p><p>Waymo is the only company successfully operating a commercial fully autonomous ride-hailing service at scale in multiple complex urban environments, and we’re ramping up with these new expansions. We’ll continue to follow our market entry playbook, always leading with safety, and continue to engage the community to earn trust and generate excitement to ride.</p><p>“Waymo is serving more riders than ever, as we are on track to serve over one million rides per week by the end of this year,” said Tekedra Mawakana, co-CEO of Waymo. “Dallas, Houston, San Antonio, and Orlando are critical to our plans, as we lay groundwork for service in 20+ cities. Each community has its own unique charm and transportation needs, and we’re eager to provide a safe, reliable, and magical way for locals and visitors to travel.”</p><div class="_container_1whbh_2"><w-equalize-heights><w-carousel loop="true"><ul data-slot="slides-container" class="_gallery_1whbh_6"><li id="w-i7etb3s9-slide-0" data-index="0" aria-current="true" class="_galleryItem_1whbh_42"><w-media><figure class="_figure_1whbh_53"><div class="_assetContainer_1whbh_58"><div data-equalize-heights="slide-asset" class="_asset_1whbh_58"><picture class="_picture_1yfl2_2"><source srcset="//lh3.googleusercontent.com/pd9RxwFSwp5rTiyrrIIaWo3dXsFGCQgOCxLwqrNDohDMXRmroVMuecN0lOpRO0K6ujF93SXzMnDPyYt6ARI_0KKmOISZJfy-XQ=e365-s2000-rw-v1 2x, //lh3.googleusercontent.com/pd9RxwFSwp5rTiyrrIIaWo3dXsFGCQgOCxLwqrNDohDMXRmroVMuecN0lOpRO0K6ujF93SXzMnDPyYt6ARI_0KKmOISZJfy-XQ=e365-s1000-rw-v1 1x" media="(min-width: 600px)" type="image/webp" width="1920" height="1080"/><source srcset="//lh3.googleusercontent.com/pd9RxwFSwp5rTiyrrIIaWo3dXsFGCQgOCxLwqrNDohDMXRmroVMuecN0lOpRO0K6ujF93SXzMnDPyYt6ARI_0KKmOISZJfy-XQ=e365-s2000-v1 2x, //lh3.googleusercontent.com/pd9RxwFSwp5rTiyrrIIaWo3dXsFGCQgOCxLwqrNDohDMXRmroVMuecN0lOpRO0K6ujF93SXzMnDPyYt6ARI_0KKmOISZJfy-XQ=e365-s1000 1x" media="(min-width: 600px)" type="image/jpeg" width="1920" height="1080"/><source srcset="//lh3.googleusercontent.com/pd9RxwFSwp5rTiyrrIIaWo3dXsFGCQgOCxLwqrNDohDMXRmroVMuecN0lOpRO0K6ujF93SXzMnDPyYt6ARI_0KKmOISZJfy-XQ=e365-s800-rw-v1 2x, //lh3.googleusercontent.com/pd9RxwFSwp5rTiyrrIIaWo3dXsFGCQgOCxLwqrNDohDMXRmroVMuecN0lOpRO0K6ujF93SXzMnDPyYt6ARI_0KKmOISZJfy-XQ=e365-s400-rw-v1 1x" media="(max-width: 599px)" type="image/webp" width="1920" height="1080"/><img alt="Blog 1920x1080 Dallas" loading="lazy" fetchpriority="auto" srcset="//lh3.googleusercontent.com/pd9RxwFSwp5rTiyrrIIaWo3dXsFGCQgOCxLwqrNDohDMXRmroVMuecN0lOpRO0K6ujF93SXzMnDPyYt6ARI_0KKmOISZJfy-XQ=e365-s800-v1 2x, //lh3.googleusercontent.com/pd9RxwFSwp5rTiyrrIIaWo3dXsFGCQgOCxLwqrNDohDMXRmroVMuecN0lOpRO0K6ujF93SXzMnDPyYt6ARI_0KKmOISZJfy-XQ=e365-s400 1x" src="//lh3.googleusercontent.com/pd9RxwFSwp5rTiyrrIIaWo3dXsFGCQgOCxLwqrNDohDMXRmroVMuecN0lOpRO0K6ujF93SXzMnDPyYt6ARI_0KKmOISZJfy-XQ=e365-s400" width="1920" height="1080" class="_image_1yfl2_5"/></picture></div></div></figure></w-media></li><li id="w-i7etb3s9-slide-1" data-index="1" class="_galleryItem_1whbh_42"><w-media><figure class="_figure_1whbh_53"><div class="_assetContainer_1whbh_58"><div data-equalize-heights="slide-asset" class="_asset_1whbh_58"><picture class="_picture_1yfl2_2"><source srcset="//lh3.googleusercontent.com/EN2N1CJf2Bu5t0GWOk5Hhs3zILadSJu3fyCgcBL6qa0b2TGKJb4YK-RLdMf4TUuCdAJL7dP1wV2i7nnajcjepkUqIBA4yDjrbWc=e365-s2000-rw-v1 2x, //lh3.googleusercontent.com/EN2N1CJf2Bu5t0GWOk5Hhs3zILadSJu3fyCgcBL6qa0b2TGKJb4YK-RLdMf4TUuCdAJL7dP1wV2i7nnajcjepkUqIBA4yDjrbWc=e365-s1000-rw-v1 1x" media="(min-width: 600px)" type="image/webp" width="1920" height="1080"/><source srcset="//lh3.googleusercontent.com/EN2N1CJf2Bu5t0GWOk5Hhs3zILadSJu3fyCgcBL6qa0b2TGKJb4YK-RLdMf4TUuCdAJL7dP1wV2i7nnajcjepkUqIBA4yDjrbWc=e365-s2000-v1 2x, //lh3.googleusercontent.com/EN2N1CJf2Bu5t0GWOk5Hhs3zILadSJu3fyCgcBL6qa0b2TGKJb4YK-RLdMf4TUuCdAJL7dP1wV2i7nnajcjepkUqIBA4yDjrbWc=e365-s1000 1x" media="(min-width: 600px)" type="image/jpeg" width="1920" height="1080"/><source srcset="//lh3.googleuserconte