  /**
   * Testing affordance: `?resetconsent` (or `?resetconsent=1`) clears the
   * stored choice so the next render behaves like a first-time visit. Useful
   * with `?gl=<country>` for exercising a jurisdiction's flow repeatedly
   * without hunting for the cookie in devtools.
   *
   * The param is then stripped from the URL via history.replaceState so a
   * reload/share doesn't silently keep wiping the visitor's real choice.
   * Safe to ship: it only ever DELETES local consent state (the privacy-safe
   * direction) and can't grant consent or read anything.
   */
  function maybeResetConsent(cfg) {
    var params;
    try {
      params = new URL(location.href).searchParams;
    } catch (e) {
      return false;
    }
    if (!params.has('resetconsent')) {
      return false;
    }
    var value = params.get('resetconsent');
    // `?resetconsent=0` / `=false` opts out, everything else resets.
    if (value === '0' || value === 'false') {
      return false;
    }
    deleteCookie(cfg.cookieName);
    try {
      localStorage.removeItem(cfg.cookieName);
    } catch (e) {
