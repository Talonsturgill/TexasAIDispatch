    } catch (e) {
      // Non-fatal: the reset already happened.
    }
    return true;
  }

  function isInitialSessionLanding(cookieName) {
    var key = (cookieName || 'root-consent') + '-session-seen';
    try {
      if (sessionStorage.getItem(key)) {
        return false;
      }
      sessionStorage.setItem(key, 'true');
      return true;
    } catch (e) {
      // If sessionStorage throws (e.g. quota, security policy), treat as initial landing.
      return true;
    }
  }

  function readStored(cfg) {
    var raw = getCookie(cfg.cookieName);
    if (!raw) {
      return null;
    }
    try {
      var data = JSON.parse(raw);
      // Re-prompt on a policy-version bump (material change).
      if (data && data.version === cfg.policyVersion) {
        return data;
      }
    } catch (e) {
      // fall through
    }
    return null;
  }

  function defaultCategories(cfg) {
    var state = {essential: true};
    cfg.categories.forEach(function (c) {
      if (c.id !== 'essential') {
        state[c.id] = !!c.defaultOn;
      }
    });
    return state;
  }

  function consentModeMap(categories) {
    return {
      ad_storage: categories.advertising ? 'granted' : 'denied',
      ad_user_data: categories.advertising ? 'granted' : 'denied',
      ad_personalization: categories.advertising ? 'granted' : 'denied',
      analytics_storage: categories.analytics ? 'granted' : 'denied',
      functionality_storage: categories.functional ? 'granted' : 'denied',
      personalization_storage: categories.functional ? 'granted' : 'denied',
      security_storage: 'granted',
