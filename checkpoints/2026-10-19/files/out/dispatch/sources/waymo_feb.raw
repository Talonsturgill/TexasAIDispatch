      clearTimeout(this.delayTimer);
      this.delayTimer = null;
    }
    this.categories = categories;
    this.consentId = this.consentId || randomId();
    var payload = {
      id: this.consentId,
      version: this.cfg.policyVersion,
      jurisdiction: this.cfg.jurisdiction.mode,
      categories: categories,
      mechanism: mechanism,
      gpc: hasGpc(),
      ts: Date.now(),
