    this.cfg = cfg;
    this.banner = el.querySelector('[data-consent-banner]');
    this.prefs = el.querySelector('[data-consent-prefs]');
    this.consentId = null;
    this.categories = null;
    this.delayTimer = null;
  }

  CookieConsent.prototype.persist = function (categories, mechanism) {
