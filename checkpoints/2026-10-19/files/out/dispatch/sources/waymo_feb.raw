      localStorage.setItem(this.cfg.cookieName, JSON.stringify(payload));
    } catch (e) {
      // localStorage may be unavailable; cookie is the source of truth.
    }
    gtagUpdate(categories);
    dispatchState(categories, mechanism);
    this.postReceipt(payload, mechanism);
  };

  CookieConsent.prototype.postReceipt = function (payload, mechanism) {
    try {
      var body = JSON.stringify({
        consentId: payload.id,
        policyVersion: this.cfg.policyVersion,
        jurisdiction:
          this.cfg.jurisdiction.mode +
          (this.cfg.jurisdiction.country
            ? ':' + this.cfg.jurisdiction.country
            : ''),
        categories: payload.categories,
        mechanism: mechanism,
        gpc: payload.gpc,
      });
