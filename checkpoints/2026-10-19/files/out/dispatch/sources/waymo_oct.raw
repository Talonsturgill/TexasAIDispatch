</div><a href="/updates/" data-tracking="{&quot;event&quot;:&quot;newsletter_cta&quot;,&quot;click_text&quot;:&quot;Sign up&quot;,&quot;section_title&quot;:&quot;footer&quot;}" class="_link_b7krl_11 variant:primary color:blue">Sign up</a></section><hr class="_divider_zgq1c_194"/><ul class="_socials_zgq1c_52"><li><a href="https://twitter.com/waymo/" data-tracking="{}" title="Waymo on X" class="_link_b7krl_11 variant:plain color:black"><svg aria-hidden="false" aria-label="Waymo on X" class="_logo-twitter_zgq1c_238"><use href="/assets/BDOs7_Uj.svg#logo-twitter"></use></svg></a></li><li><a href="https://www.linkedin.com/company/waymo" data-tracking="{}" title="Waymo on LinkedIn" class="_link_b7krl_11 variant:plain color:black"><svg aria-hidden="false" aria-label="Waymo on LinkedIn" class="_logo-linkedin_zgq1c_242"><use href="/assets/BDOs7_Uj.svg#logo-linkedin"></use></svg></a></li><li><a href="https://www.instagram.com/waymo/?hl=en" data-tracking="{}" title="Waymo on Instagram" class="_link_b7krl_11 variant:plain color:black"><svg aria-hidden="false" aria-label="Waymo on Instagram" class="_logo-instagram_zgq1c_246"><use href="/assets/BDOs7_Uj.svg#logo-instagram"></use></svg></a></li><li><a href="https://facebook.com/waymo/" data-tracking="{}" title="Waymo on Facebook" class="_link_b7krl_11 variant:plain color:black"><svg aria-hidden="false" aria-label="Waymo on Facebook" class="_logo-facebook_zgq1c_250"><use href="/assets/BDOs7_Uj.svg#logo-facebook"></use></svg></a></li><li><a href="https://www.youtube.com/waymo" data-tracking="{}" title="Waymo on YouTube" class="_link_b7krl_11 variant:plain color:black"><svg aria-hidden="false" aria-label="Waymo on YouTube" class="_logo-youtube_zgq1c_254"><use href="/assets/BDOs7_Uj.svg#logo-youtube"></use></svg></a></li><li><a href="https://www.tiktok.com/@waymo" data-tracking="{}" title="Waymo on Tiktok" class="_link_b7krl_11 variant:plain color:black"><svg aria-hidden="false" aria-label="Waymo on Tiktok" class="_logo-tiktok_zgq1c_258"><use href="/assets/BDOs7_Uj.svg#logo-tiktok"></use></svg></a></li></ul><p class="_copyright_zgq1c_279">© 2019-2026 Waymo LLC</p></div></footer></div><root-consent><style nonce="kFRX8GVwCZAMY6I3hkB9FQ==">/* Styles for the <root-consent> banner + preference center. Scoped under the
 * custom element tag so they can't leak into the host page. Injected inline
 * (CSP nonce) by the SSR template, kept small for the critical path.
 *
 * The custom properties below are the theming surface: a site can restyle the
 * banner by setting them on `root-consent` (or any ancestor) from its own CSS.
 */
root-consent {
  --rc-bg: #ffffff;
  --rc-fg: #202124;
  --rc-muted: #5f6368;
  --rc-border: #dadce0;
  --rc-accent: #1a73e8;
  --rc-accent-hover: #1765cc;
  --rc-accent-fg: #ffffff;
  --rc-radius: 12px;
}

root-consent [hidden] {
  display: none !important;
}

root-consent .rc-banner {
  position: fixed;
  z-index: 2147483000;
  left: 16px;
  right: 16px;
  bottom: 16px;
  max-width: 560px;
  margin-inline: auto;
  background: var(--rc-bg);
  color: var(--rc-fg);
  border: 1px solid var(--rc-border);
  border-radius: var(--rc-radius);
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
  padding: 20px;
  font-family: inherit;
  font-size: 14px;
  line-height: 1.5;
}

root-consent .rc-title {
  margin: 0 0 8px;
  font-size: 16px;
  font-weight: 600;
}

root-consent .rc-body {
  margin: 0 0 16px;
  color: var(--rc-muted);
}

root-consent .rc-body p {
  margin: 0 0 8px;
}

root-consent .rc-body p:last-child {
  margin-bottom: 0;
}

root-consent .rc-body a {
  color: var(--rc-accent);
}

root-consent .rc-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

root-consent .rc-btn {
  appearance: none;
  cursor: pointer;
  border-radius: 999px;
  border: 1px solid var(--rc-border);
  background: var(--rc-bg);
  color: var(--rc-fg);
  padding: 9px 18px;
  font: inherit;
  font-weight: 500;
}

root-consent .rc-btn:hover {
  background: #f1f3f4;
}

root-consent .rc-btn--primary {
  background: var(--rc-accent);
  border-color: var(--rc-accent);
  color: var(--rc-accent-fg);
}

root-consent .rc-btn--primary:hover {
  background: var(--rc-accent-hover);
}

/* Less-prominent "Manage Preferences" / "Save Preferences" action: styled as a
 * text link so the primary Accept All / Reject All buttons stay dominant and
 * visually equivalent to each other. */
root-consent .rc-btn--link {
  background: transparent;
  border-color: transparent;
  color: var(--rc-accent);
  padding-inline: 8px;
  text-decoration: underline;
}

root-consent .rc-btn--link:hover {
  background: transparent;
  text-decoration: none;
}

root-consent .rc-btn:focus-visible {
  outline: 2px solid var(--rc-accent);
  outline-offset: 2px;
}

/* Preference center (modal) */
root-consent .rc-prefs {
  position: fixed;
  z-index: 2147483001;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  background: rgba(32, 33, 36, 0.5);
}

root-consent .rc-prefs-dialog {
  background: var(--rc-bg);
  color: var(--rc-fg);
  border-radius: var(--rc-radius);
  max-width: 560px;
  width: 100%;
  max-height: 85vh;
  overflow: auto;
  padding: 24px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
}

root-consent .rc-prefs-title {
  margin: 0 0 16px;
  font-size: 18px;
  font-weight: 600;
}

root-consent .rc-cat {
  display: flex;
  gap: 12px;
  padding: 14px 0;
  border-top: 1px solid var(--rc-border);
}

root-consent .rc-cat-text {
  flex: 1;
}

root-consent .rc-cat-name {
  font-weight: 500;
  margin: 0 0 4px;
}

root-consent .rc-cat-desc {
  color: var(--rc-muted);
  font-size: 13px;
  margin: 0;
}

/* Legal note above the preference-center actions. Sits below the last
 * category, so it takes the same top border the categories use. */
root-consent .rc-prefs-note {
  border-top: 1px solid var(--rc-border);
  padding-top: 14px;
  color: var(--rc-muted);
  font-size: 13px;
}

root-consent .rc-prefs-note p {
  margin: 0 0 8px;
}

root-consent .rc-prefs-note p:last-child {
  margin-bottom: 0;
}

root-consent .rc-prefs-note a {
  color: var(--rc-accent);
}

/* Collapse the note's spacing when the CMS leaves it empty. */
root-consent .rc-prefs-note:empty {
  display: none;
}

root-consent .rc-prefs-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 20px;
}

@media (prefers-reduced-motion: no-preference) {
  root-consent .rc-banner {
    animation: rc-slide-up 0.18s ease-out;
  }
}

@keyframes rc-slide-up {
  from {
    transform: translateY(12px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
</style><div data-consent-banner="true" hidden role="dialog" aria-modal="false" aria-label="We value your privacy" aria-describedby="rc-banner-body" class="rc-banner"><p class="rc-title">We value your privacy</p><div id="rc-banner-body" class="rc-body"><p>Waymo and our third-party partners use cookies and similar technologies to ensure our website functions correctly, to analyze site traffic and performance, and to deliver personalized marketing and content. Essential cookies are automatically active to keep our site running safely and reliably. <b>For non-essential cookies, below you can choose to accept all of them, reject all of them, or customize your preferences.</b> You can change your preferences or withdraw your consent at any time by clicking "Cookie Settings" in the website footer. For more detailed information, please review our <a href="https://waymo.com/privacy/">Privacy Policy</a>.</p></div><div class="rc-actions"><button type="button" data-consent-action="accept" class="rc-btn rc-btn--primary">Accept All</button><button type="button" data-consent-action="reject" class="rc-btn rc-btn--primary">Reject All</button><button type="button" data-consent-action="customize" class="rc-btn rc-btn--link">Manage Preferences</button></div></div><div data-consent-prefs="true" hidden class="rc-prefs"><div role="dialog" aria-modal="true" aria-label="Manage Preferences" class="rc-prefs-dialog"><p class="rc-prefs-title">Manage Preferences</p><div class="rc-cat"><div class="rc-cat-text"><p class="rc-cat-name">Strictly Necessary Cookies</p><p class="rc-cat-desc">These cookies are essential for the website to function properly, enabling core features like network security, load balancing, and remembering your privacy preferences. They cannot be switched off in our systems.</p></div><div><label class="rc-switch"><input type="checkbox" data-category="essential" checked disabled aria-label="Strictly Necessary Cookies"/></label></div></div><div class="rc-cat"><div class="rc-cat-text"><p class="rc-cat-name">Analytics Cookies</p><p class="rc-cat-desc">These cookies allow us and our analytics partners to count visits and traffic sources so we can measure and improve the performance of waymo.com. They help us understand which pages are most and least popular and see how visitors move around the site.</p></div><div><label class="rc-switch"><input type="checkbox" data-category="analytics" aria-label="Analytics Cookies"/></label></div></div><div class="rc-cat"><div class="rc-cat-text"><p class="rc-cat-name">Marketing &amp; Advertising Cookies</p><p class="rc-cat-desc">These cookies may be set through our site by us and our advertising partners. They may be used by us and those companies to build a profile of your interests and show you relevant advertisements on other websites and platforms.</p></div><div><label class="rc-switch"><input type="checkbox" data-category="advertising" aria-label="Marketing &amp; Advertising Cookies"/></label></div></div><div class="rc-cat"><div class="rc-cat-text"><p class="rc-cat-name">Functional &amp; Personalization Cookies</p><p class="rc-cat-desc">These cookies enable the website to provide enhanced functionality and personalization, such as remembering your language preferences or regional settings. If you do not allow these cookies, some or all of these services may not function properly.</p></div><div><label class="rc-switch"><input type="checkbox" data-category="functional" aria-label="Functional &amp; Personalization Cookies"/></label></div></div><div class="rc-prefs-note"><p>If you choose to "Reject All", we will only use strictly necessary cookies.</p></div><div class="rc-prefs-actions"><button type="button" data-consent-action="accept" class="rc-btn rc-btn--primary">Accept All</button><button type="button" data-consent-action="reject" class="rc-btn rc-btn--primary">Reject All</button><button type="button" data-consent-action="save" class="rc-btn rc-btn--link">Save Preferences</button></div></div></div><script type="application/json" data-consent-config="true" nonce="kFRX8GVwCZAMY6I3hkB9FQ==">{"enabled":true,"flag":"EnableCookieConsent","showCustomizeButton":true,"simulate":false,"policyVersion":"1","cookieName":"waymo-consent","cookieTtlDays":390,"jurisdiction":{"country":"","region":"","mode":"opt-in","tagLoading":"on-consent","defaults":{"essential":true,"analytics":false,"advertising":false,"functional":false},"footerControl":"cookie-settings","initialCookieDelayDuration":0},"recordUrl":"/api/consent.record","copy":{"bannerTitle":"We value your privacy","bannerBody":{"time":1700000000000,"version":"2.28.2","blocks":[{"type":"paragraph","data":{"text":"Waymo and our third-party partners use cookies and similar technologies to ensure our website functions correctly, to analyze site traffic and performance, and to deliver personalized marketing and content. Essential cookies are automatically active to keep our site running safely and reliably. <b>For non-essential cookies, below you can choose to accept all of them, reject all of them, or customize your preferences.</b> You can change your preferences or withdraw your consent at any time by clicking \"Cookie Settings\" in the website footer. For more detailed information, please review our <a href=\"https://waymo.com/privacy/\">Privacy Policy</a>."}}]},"prefsNote":{"version":"2.28.2","time":1700000000000,"blocks":[{"type":"paragraph","data":{"text":"If you choose to \"Reject All\", we will only use strictly necessary cookies."}}]},"acceptAllLabel":"Accept All","rejectAllLabel":"Reject All","customizeLabel":"Manage Preferences","savePreferencesLabel":"Save Preferences","preferencesTitle":"Manage Preferences"},"categories":[{"id":"essential","label":"Strictly Necessary Cookies","description":"These cookies are essential for the website to function properly, enabling core features like network security, load balancing, and remembering your privacy preferences. They cannot be switched off in our systems.","required":true,"defaultOn":true},{"id":"analytics","label":"Analytics Cookies","description":"These cookies allow us and our analytics partners to count visits and traffic sources so we can measure and improve the performance of waymo.com. They help us understand which pages are most and least popular and see how visitors move around the site.","required":false,"defaultOn":false},{"id":"advertising","label":"Marketing & Advertising Cookies","description":"These cookies may be set through our site by us and our advertising partners. They may be used by us and those companies to build a profile of your interests and show you relevant advertisements on other websites and platforms.","required":false,"defaultOn":false},{"id":"functional","label":"Functional & Personalization Cookies","description":"These cookies enable the website to provide enhanced functionality and personalization, such as remembering your language preferences or regional settings. If you do not allow these cookies, some or all of these services may not function properly.","required":false,"defaultOn":false}]}</script><script nonce="kFRX8GVwCZAMY6I3hkB9FQ==" data-consent-count="3">/**
 * `<root-consent>` custom element — the client runtime for the cookie-consent
 * pod.
 *
 * It is server-rendered with its config in a `<script type="application/json">`
 * child. On connect it:
 *   1. Reads any stored choice (cookie) + Global Privacy Control.
 *   2. Updates Google Consent Mode v2 (`gtag('consent','update',…)`).
 *   3. Loads gated tags (via a `root-consent-grant` event) when allowed.
 *   4. Shows the banner / preference center when a choice is needed, wires the
 *      buttons, persists the choice, and posts an audit receipt.
 *
 * Exposes `window.rootConsent` with `get()`, `grant()`, `deny()`,
 * `update(categories)`, and `openSettings()`.
 *
 * This file is intentionally dependency-free vanilla JS so it can be injected
 * inline (CSP nonce) and run before/independent of the main bundle.
 */
(function () {
  if (window.__rootConsentInit) {
    return;
  }
  window.__rootConsentInit = true;

  var NON_ESSENTIAL = ['analytics', 'advertising', 'functional'];

  function readConfig(el) {
    var script = el.querySelector('script[data-consent-config]');
    if (!script) {
      return null;
    }
    try {
      return JSON.parse(script.textContent || '{}');
    } catch (e) {
      return null;
    }
  }

  function hasGpc() {
    return navigator.globalPrivacyControl === true;
  }

  function getCookie(name) {
    var match = document.cookie.match(
      new RegExp(
        '(?:^|; )' + name.replace(/[.$?*|{}()[\]\\/+^]/g, '\\$&') + '=([^;]*)'
      )
    );
    return match ? decodeURIComponent(match[1]) : null;
  }

  function setCookie(name, value, days) {
    var expires = new Date(Date.now() + days * 864e5).toUTCString();
    var secure = location.protocol === 'https:' ? '; Secure' : '';
    document.cookie =
      name +
      '=' +
      encodeURIComponent(value) +
      '; Path=/; Max-Age=' +
      (days * 864e5) / 1000 +
      '; Expires=' +
      expires +
      '; SameSite=Lax' +
      secure;
  }

  function deleteCookie(name) {
    var secure = location.protocol === 'https:' ? '; Secure' : '';
    document.cookie =
      name +
      '=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT' +
      '; SameSite=Lax' +
      secure;
  }

  /**
   * Testing affordance: `?resetconsent` (or `?resetconsent=1`) clears the
   * stored choice so the next render behaves like a first-time visit. Useful
   * with `?gl=<country>` for exercising a jurisdiction's flow repeatedly
   * without hunting for the cookie in devtools.
   *
   * The param is then stripped from the URL via history.replaceState so a
   * reload/share doesn't silently keep wiping the visitor's real choice.
   * Safe to ship: it only ever DELETES local consent state (the privacy-safe
   * direction) and can't grant consent or read anything.
   */
  function maybeResetConsent(cfg) {
    var params;
    try {
      params = new URL(location.href).searchParams;
    } catch (e) {
      return false;
    }
    if (!params.has('resetconsent')) {
      return false;
    }
    var value = params.get('resetconsent');
    // `?resetconsent=0` / `=false` opts out, everything else resets.
    if (value === '0' || value === 'false') {
      return false;
    }
    deleteCookie(cfg.cookieName);
    try {
      localStorage.removeItem(cfg.cookieName);
    } catch (e) {
      // localStorage may be unavailable; the cookie is the source of truth.
    }
    try {
      sessionStorage.removeItem((cfg.cookieName || 'root-consent') + '-session-seen');
    } catch (e) {
      // Non-fatal
    }
    try {
      var url = new URL(location.href);
      url.searchParams.delete('resetconsent');
      history.replaceState(null, '', url.toString());
    } catch (e) {
      // Non-fatal: the reset already happened.
    }
    return true;
  }

  function isInitialSessionLanding(cookieName) {
    var key = (cookieName || 'root-consent') + '-session-seen';
    try {
      if (sessionStorage.getItem(key)) {
        return false;
      }
      sessionStorage.setItem(key, 'true');
      return true;
    } catch (e) {
      // If sessionStorage throws (e.g. quota, security policy), treat as initial landing.
      return true;
    }
  }

  function readStored(cfg) {
    var raw = getCookie(cfg.cookieName);
    if (!raw) {
      return null;
    }
    try {
      var data = JSON.parse(raw);
      // Re-prompt on a policy-version bump (material change).
      if (data && data.version === cfg.policyVersion) {
        return data;
      }
    } catch (e) {
      // fall through
    }
    return null;
  }

  function defaultCategories(cfg) {
    var state = {essential: true};
    cfg.categories.forEach(function (c) {
      if (c.id !== 'essential') {
        state[c.id] = !!c.defaultOn;
      }
    });
    return state;
  }

  function consentModeMap(categories) {
    return {
      ad_storage: categories.advertising ? 'granted' : 'denied',
      ad_user_data: categories.advertising ? 'granted' : 'denied',
      ad_personalization: categories.advertising ? 'granted' : 'denied',
      analytics_storage: categories.analytics ? 'granted' : 'denied',
      functionality_storage: categories.functional ? 'granted' : 'denied',
      personalization_storage: categories.functional ? 'granted' : 'denied',
      security_storage: 'granted',
    };
  }

  function gtagUpdate(categories) {
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    gtag('consent', 'update', consentModeMap(categories));
  }

  function dispatchState(categories, mechanism) {
    // Signal the rest of the app. The tag loader listens for this and the
    // existing `tracking-loaded` event so analytics.js can boot.
    var granted = NON_ESSENTIAL.some(function (k) {
      return categories[k];
    });
    window.rootConsentState = {categories: categories, mechanism: mechanism};
    window.dispatchEvent(
      new CustomEvent('root-consent-change', {
        detail: {categories: categories, mechanism: mechanism},
      })
    );
    if (granted) {
      window.rootConsentGranted = true;
      window.dispatchEvent(
        new CustomEvent('root-consent-grant', {
          detail: {categories: categories},
        })
      );
    }
  }

  function randomId() {
    if (window.crypto && window.crypto.randomUUID) {
      return window.crypto.randomUUID();
    }
    return 'c_' + Math.random().toString(36).slice(2) + Date.now().toString(36);
  }

  function CookieConsent(el, cfg) {
    this.el = el;
    this.cfg = cfg;
    this.banner = el.querySelector('[data-consent-banner]');
    this.prefs = el.querySelector('[data-consent-prefs]');
    this.consentId = null;
    this.categories = null;
    this.delayTimer = null;
  }

  CookieConsent.prototype.persist = function (categories, mechanism) {
    if (this.delayTimer) {
      clearTimeout(this.delayTimer);
      this.delayTimer = null;
    }
    this.categories = categories;
    this.consentId = this.consentId || randomId();
    var payload = {
      id: this.consentId,
      version: this.cfg.policyVersion,
      jurisdiction: this.cfg.jurisdiction.mode,
      categories: categories,
      mechanism: mechanism,
      gpc: hasGpc(),
      ts: Date.now(),
    };
    // Simulation mode (internal CMS preview): don't touch the real consent
    // cookie/localStorage and don't post an audit receipt — just reflect the
    // choice locally so the tester can see the resulting behavior + Consent
    // Mode signals, then emit a `root-consent-sim` event the simulator UI
    // listens to for its live readout.
    if (this.cfg.simulate) {
      gtagUpdate(categories);
      dispatchState(categories, mechanism);
      try {
        window.dispatchEvent(
          new CustomEvent('root-consent-sim', {
            detail: {payload: payload, mechanism: mechanism},
          })
        );
      } catch (e) {
        // ignore
      }
      return;
    }
    setCookie(
      this.cfg.cookieName,
      JSON.stringify(payload),
      this.cfg.cookieTtlDays
    );
    try {
      localStorage.setItem(this.cfg.cookieName, JSON.stringify(payload));
    } catch (e) {
      // localStorage may be unavailable; cookie is the source of truth.
    }
    gtagUpdate(categories);
    dispatchState(categories, mechanism);
    this.postReceipt(payload, mechanism);
  };

  CookieConsent.prototype.postReceipt = function (payload, mechanism) {
    try {
      var body = JSON.stringify({
        consentId: payload.id,
        policyVersion: this.cfg.policyVersion,
        jurisdiction:
          this.cfg.jurisdiction.mode +
          (this.cfg.jurisdiction.country
            ? ':' + this.cfg.jurisdiction.country
            : ''),
        categories: payload.categories,
        mechanism: mechanism,
        gpc: payload.gpc,
      });
      // Non-blocking; failures are non-fatal (choice already enforced locally).
      if (navigator.sendBeacon) {
        navigator.sendBeacon(
          this.cfg.recordUrl,
          new Blob([body], {type: 'application/json'})
        );
      } else {
        fetch(this.cfg.recordUrl, {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: body,
          keepalive: true,
        }).catch(function () {});
      }
    } catch (e) {
      // ignore
    }
  };

  CookieConsent.prototype.hideBanner = function () {
    if (this.banner) {
      this.banner.hidden = true;
    }
  };

  CookieConsent.prototype.showBanner = function () {
    if (this.banner) {
      this.banner.hidden = false;
    }
  };

  CookieConsent.prototype.openSettings = function () {
    if (this.delayTimer) {
      clearTimeout(this.delayTimer);
      this.delayTimer = null;
    }
    if (!this.prefs) {
      return;
    }
    this.syncToggles(
      this.categories || readStored(this.cfg)
        ? this.categories || readStored(this.cfg).categories
        : defaultCategories(this.cfg)
    );
    // The preference center is a modal that supersedes the banner: keep the
    // banner out of the backdrop so it can't show through behind the dialog
    // (and so a returning visitor opening settings from the footer doesn't
    // suddenly get re-prompted). `restoreBanner()` puts it back if the visitor
    // dismisses the modal without making a choice.
    this.hideBanner();
    this.prefs.hidden = false;
    // Move focus into the dialog. Skip disabled controls — the first control is
    // the always-on "strictly necessary" checkbox, which is disabled, and
    // calling focus() on it silently leaves focus on <body> (so Escape and
    // other dialog keys never reach us).
    var focusable = this.prefs.querySelectorAll(
      'input,button,select,a[href],[tabindex]'
    );
    for (var i = 0; i < focusable.length; i++) {
      if (!focusable[i].disabled && focusable[i].focus) {
        focusable[i].focus();
        break;
      }
    }
  };

  CookieConsent.prototype.closeSettings = function () {
    if (this.prefs) {
      this.prefs.hidden = true;
    }
  };

  /**
   * Called after the preference center is dismissed WITHOUT a choice being
   * saved. Re-shows the banner only when the visitor still owes us one — a
   * stored choice (or a jurisdiction that never prompts) leaves it hidden.
   */
  CookieConsent.prototype.restoreBanner = function () {
    if (readStored(this.cfg) || this.cfg.jurisdiction.mode === 'silent') {
      this.hideBanner();
    } else {
      this.showBanner();
    }
  };

  CookieConsent.prototype.syncToggles = function (categories) {
    if (!this.prefs) {
      return;
    }
    NON_ESSENTIAL.forEach(function (id) {
      var input = this.prefs.querySelector('input[data-category="' + id + '"]');
      if (input) {
        input.checked = !!categories[id];
      }
    }, this);
  };

  CookieConsent.prototype.readToggles = function () {
    var state = {essential: true};
    NON_ESSENTIAL.forEach(function (id) {
      var input = this.prefs
        ? this.prefs.querySelector('input[data-category="' + id + '"]')
        : null;
      state[id] = input ? input.checked : false;
    }, this);
    return state;
  };

  CookieConsent.prototype.acceptAll = function () {
    // Grants only the categories this site actually declares, so a site that
    // uses analytics alone never records a grant for advertising cookies it
    // doesn't set.
    var state = {essential: true};
    var configured = {};
    this.cfg.categories.forEach(function (c) {
      configured[c.id] = true;
    });
    NON_ESSENTIAL.forEach(function (id) {
      state[id] = configured[id] === true;
    });
    this.persist(state, 'banner');
    this.hideBanner();
    this.closeSettings();
  };

  CookieConsent.prototype.rejectAll = function () {
    var state = {
      essential: true,
      analytics: false,
      advertising: false,
      functional: false,
    };
    this.persist(state, 'banner');
    this.hideBanner();
    this.closeSettings();
  };

  CookieConsent.prototype.savePrefs = function () {
    var state = this.readToggles();
    this.persist(state, 'settings');
    this.hideBanner();
    this.closeSettings();
  };

  CookieConsent.prototype.wire = function () {
    var self = this;
    this.el.addEventListener('click', function (e) {
      var t = e.target.closest('[data-consent-action]');
      if (!t) {
        return;
      }
      var action = t.getAttribute('data-consent-action');
      e.preventDefault();
      if (action === 'accept') {
        self.acceptAll();
      } else if (action === 'reject') {
        self.rejectAll();
      } else if (action === 'customize') {
        self.openSettings();
      } else if (action === 'save') {
        self.savePrefs();
      } else if (action === 'close') {
        self.closeSettings();
        // Dismissed without choosing: re-prompt only if a choice is still owed.
        self.restoreBanner();
      }
    });
    // A persistent footer/anywhere trigger can open settings.
    document.addEventListener('click', function (e) {
      var t = e.target.closest('[data-open-consent-settings]');
      if (t) {
        e.preventDefault();
        self.openSettings();
      }
    });
    // Escape closes the preference center. Bound on the document (not the
    // element) so it works regardless of where focus currently sits.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && self.prefs && !self.prefs.hidden) {
        self.closeSettings();
        self.restoreBanner();
      }
    });
  };

  CookieConsent.prototype.init = function () {
    var gpc = hasGpc();

    // `?resetconsent` clears any stored choice first, so the rest of init()
    // runs the genuine first-time-visitor path for this jurisdiction.
    maybeResetConsent(this.cfg);

    // Simulation mode (internal CMS preview): ignore any stored choice and
    // always present the banner exactly as a first-time visitor in the selected
    // jurisdiction would see it. Apply the jurisdiction defaults / GPC behavior
    // for the Consent Mode readout, but never persist.
    if (this.cfg.simulate) {
      var simDefaults = defaultCategories(this.cfg);
      if (gpc && this.cfg.jurisdiction.mode !== 'opt-in') {
        simDefaults.advertising = false;
      }
      gtagUpdate(simDefaults);
      if (this.cfg.jurisdiction.mode !== 'opt-in') {
        dispatchState(simDefaults, 'banner');
      }
      // `silent` suppresses the banner by default; reflect that in the preview.
      if (this.cfg.jurisdiction.mode === 'silent') {
        this.hideBanner();
      } else {
        this.showBanner();
      }
      this.wire();
      this.exposeApi();
      return;
    }

    var stored = readStored(this.cfg);

    if (stored && stored.categories) {
      // Honor the stored choice.
      this.consentId = stored.id || null;
      this.categories = stored.categories;
      gtagUpdate(stored.categories);
      dispatchState(stored.categories, 'reconsent');
      this.hideBanner();
    } else if (gpc && this.cfg.jurisdiction.mode !== 'opt-in') {
      // GPC signal present: automatic opt-out of advertising worldwide
      // (in opt-in jurisdictions, non-essential cookies are already off by default).
      var gpcState = defaultCategories(this.cfg);
      gpcState.advertising = false;
      this.persist(gpcState, 'gpc');
      this.hideBanner();
    } else if (this.cfg.jurisdiction.mode === 'silent') {
      // Silent mode: apply this jurisdiction's defaults but DON'T prompt — no
      // banner is shown. The preference center is still reachable (e.g. via the
      // footer link / window.rootConsent.openSettings()).
      var silentDefaults = defaultCategories(this.cfg);
      gtagUpdate(silentDefaults);
      dispatchState(silentDefaults, 'banner');
      this.hideBanner();
    } else {
      // No prior choice — set defaults for this jurisdiction and prompt.
      var defaults = defaultCategories(this.cfg);
      var delaySec =
        this.cfg.jurisdiction.mode === 'opt-out'
          ? Math.max(
              0,
              Math.floor(
                Number(this.cfg.jurisdiction.initialCookieDelayDuration) || 0
              )
            )
          : 0;
      var isFirstLanding = isInitialSessionLanding(this.cfg.cookieName);

      if (delaySec > 0 && isFirstLanding) {
        var self = this;
        this.delayTimer = setTimeout(function () {
          self.delayTimer = null;
          self.categories = defaults;
          gtagUpdate(defaults);
          dispatchState(defaults, 'banner');
        }, delaySec * 1000);
      } else {
        gtagUpdate(defaults);
        if (this.cfg.jurisdiction.mode !== 'opt-in') {
          dispatchState(defaults, 'banner');
        }
      }
      this.showBanner();
    }
    this.wire();
    this.exposeApi();
  };

  CookieConsent.prototype.exposeApi = function () {
    var self = this;
    window.rootConsent = {
      get: function () {
        var stored = readStored(self.cfg);
        if (stored) {
          return stored.categories;
        }
        if (self.categories) {
          return self.categories;
        }
        if (self.delayTimer) {
          var delayedState = {essential: true};
          NON_ESSENTIAL.forEach(function (id) {
            delayedState[id] = false;
          });
          return delayedState;
        }
        return defaultCategories(self.cfg);
      },
      grant: function () {
        self.acceptAll();
      },
      deny: function () {
        self.rejectAll();
      },
      update: function (categories) {
        var state = {essential: true};
        NON_ESSENTIAL.forEach(function (id) {
          state[id] = !!(categories && categories[id]);
        });
        self.persist(state, 'settings');
        self.hideBanner();
        self.closeSettings();
      },
      openSettings: function () {
        self.openSettings();
      },
      config: self.cfg,
    };
  };

  function define() {
    if (window.customElements && !window.customElements.get('root-consent')) {
      window.customElements.define(
        'root-consent',
        class extends HTMLElement {
          connectedCallback() {
            if (this.__inited) {
              return;
            }
            this.__inited = true;
            var cfg = readConfig(this);
            if (!cfg || !cfg.enabled) {
              return;
            }
            new CookieConsent(this, cfg).init();
          }
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', define);
  } else {
    define();
  }
})();
</script></root-consent>
</body></html>