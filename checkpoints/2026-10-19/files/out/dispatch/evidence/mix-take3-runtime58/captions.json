  "cues": [
    {
      "id": "c1",
      "start": 0.58,
      "end": 4.58,
      "text": "Anyone in San Antonio can now hail a Waymo with no driver,",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c2",
      "start": 4.94,
      "end": 6.12,
      "text": "the airport included.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c3",
      "start": 7.0,
      "end": 9.02,
      "text": "The service began in February",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c4",
      "start": 9.28,
      "end": 12.02,
      "text": "in a limited area of sixty square miles.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c5",
      "start": 12.64,
      "end": 16.56,
      "text": "In April, an empty Waymo was swept into Salado Creek.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c6",
      "start": 17.52,
      "end": 21.36,
      "text": "Earlier that month, another empty car was stranded in floodwater.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c7",
      "start": 22.46,
      "end": 24.56,
      "text": "Waymo filed a software recall",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c8",
      "start": 24.76,
      "end": 27.46,
      "text": "that could affect nearly thirty eight hundred cars.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c9",
      "start": 28.36,
      "end": 31.46,
      "text": "The recall says the software may let a car slow,",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c10",
      "start": 31.74,
      "end": 34.92,
      "text": "then drive into standing water on higher speed roads.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c11",
      "start": 35.78,
      "end": 39.34,
      "text": "The federal record says the remedy is currently under development.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c12",
      "start": 40.26,
      "end": 43.52,
      "text": "As an interim step, Waymo tightened its weather limits,",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c13",
      "start": 43.7,
      "end": 47.02,
      "text": "and every affected car had the update by April twentieth.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c14",
      "start": 47.94,
      "end": 49.7,
      "text": "So the airport ride is open,",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    },
    {
      "id": "c15",
      "start": 50.16,
      "end": 54.04,
      "text": "and the federal record lists the flood remedy as currently under development.",
      "source": "measured_boundary",
      "start_measured": true,
      "end_measured": true
    }
  ],
